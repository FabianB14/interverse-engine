{
  "name": "interverse-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Interverse Engine \u2014 an AI-native 2D game framework for mobile party games, cozy games, and 2D RPGs",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @interverse/hello dev",
    "dev:room": "pnpm --filter @interverse/room dev",
    "dev:taps": "pnpm --filter @interverse/taps dev",
    "relay": "pnpm --filter @interverse/relay dev",
    "build": "pnpm -r --if-present build && node scripts/check-budget.mjs",
    "preview": "pnpm --filter @interverse/hello preview",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "node scripts/verify.mjs",
    "verify:room": "node scripts/verify-room.mjs",
    "verify:net": "node scripts/verify-net.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:blobvale": "pnpm --filter @interverse/blobvale dev",
    "verify:blobvale": "node scripts/verify-blobvale.mjs",
    "dev:farm": "pnpm --filter @interverse/farm dev",
    "verify:farm": "node scripts/verify-farm.mjs",
    "verify:visit": "node scripts/verify-visit.mjs",
    "dev:hushfall": "pnpm --filter @interverse/hushfall dev",
    "verify:hushfall": "node scripts/verify-hushfall.mjs",
    "dev:studio": "pnpm --filter @interverse/studio dev",
    "verify:crashers": "node scripts/verify-crashers.mjs",
    "verify:studio": "node scripts/verify-studio.mjs",
    "ai": "node scripts/ai-bridge.mjs",
    "test": "vitest run",
    "build:site": "pnpm build && node scripts/assemble-site.mjs",
    "dev:crashers": "pnpm --filter @interverse/crashers dev",
    "dev:rush": "pnpm --filter @interverse/rush dev",
    "verify:rush": "node scripts/verify-rush.mjs",
    "dev:spike3d": "pnpm --filter @interverse/spike3d dev",
    "verify:spike3d": "node scripts/verify-spike3d.mjs",
    "budget": "node scripts/check-budget.mjs",
    "dev:rush3d": "pnpm --filter @interverse/rush3d dev",
    "verify:rush3d": "node scripts/verify-rush3d.mjs",
    "dev:crashers3d": "pnpm --filter @interverse/crashers3d dev",
    "verify:crashers3d": "node scripts/verify-crashers3d.mjs",
    "dev:haven": "pnpm --filter @interverse/haven dev",
    "verify:haven": "node scripts/verify-haven.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.61.1",
    "prettier": "^3.4.2",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^4.1.10",
    "ws": "^8.21.1",
    "zod": "^3.25.76",
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "meshoptimizer": "^0.25.0",
    "sharp": "^0.34.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}